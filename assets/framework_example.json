{
  "canvas": {
    "width_in": 6.875,
    "height_in": 1.98,
    "font_pt": 9,
    "show_region_names": false
  },
  "regions": [
    {
      "id": "enc",
      "name": "Observation encoding",
      "color": "#0072B2",
      "box": [0.04, 0.04, 2.02, 1.90],
      "desc": "A frozen encoder maps the multi-view images to features $F$; the LiDAR sweep passes on as raw geometry."
    },
    {
      "id": "agg",
      "name": "Geometry-aware aggregation",
      "color": "#E69F00",
      "box": [2.14, 0.04, 2.30, 1.90],
      "desc": "The geometry prior $\\mathcal{G}$ scores every image feature by its depth consistency with the points and rescales $F$ into $\\hat{F}$."
    },
    {
      "id": "dec",
      "name": "Decoding and supervision",
      "color": "#009E73",
      "box": [4.52, 0.04, 2.315, 1.90],
      "desc": "The decoder predicts the output from $\\hat{F}$, while $\\mathcal{L}_{\\mathrm{geo}}$ keeps the weights $W$ consistent with measured depth."
    }
  ],
  "nodes": [
    {"id": "imgs", "type": "image", "src": "samples/view.png", "box": [0.16, 1.15, 0.70, 0.50], "stack": 3,
     "label": "Multi-view images", "region": "enc"},
    {"id": "pts", "type": "points", "src": "samples/sweep.bin", "box": [0.16, 0.30, 0.80, 0.58], "view": "persp",
     "label": "LiDAR sweep", "region": "enc"},
    {"id": "enc_img", "type": "module", "text": "Image encoder", "box": [1.10, 1.20, 0.50, 0.40], "region": "enc",
     "frozen": true},
    {"id": "F", "type": "tensor", "box": [1.72, 1.18, 0.24, 0.44], "layers": 4, "label": "$F$", "region": "enc"},

    {"id": "mul", "type": "op", "op": "mul", "center": [3.31, 1.40], "r": 0.075},
    {"id": "Fhat", "type": "tensor", "box": [3.62, 1.18, 0.24, 0.44], "layers": 4, "label": "$\\hat{F}$", "region": "agg"},
    {"id": "prior", "type": "module", "text": "Geometry prior $\\mathcal{G}$", "box": [2.30, 0.38, 0.66, 0.42], "region": "agg"},
    {"id": "W", "type": "heatmap", "box": [3.10, 0.38, 0.42, 0.42], "grid": [7, 7], "seed": 2, "label": "$W$", "region": "agg"},

    {"id": "decoder", "type": "module", "text": "Decoder", "box": [4.68, 1.20, 0.56, 0.40], "region": "dec"},
    {"id": "pred", "type": "image", "src": "samples/pred.png", "box": [5.42, 1.15, 0.70, 0.50], "label": "Prediction",
     "label_pos": "above", "region": "dec"},
    {"id": "Lgeo", "type": "loss", "text": "$\\mathcal{L}_{\\mathrm{geo}}$", "box": [4.66, 0.42, 0.56, 0.34], "region": "dec"},
    {"id": "Lrec", "type": "loss", "text": "$\\mathcal{L}_{\\mathrm{rec}}$", "box": [5.49, 0.42, 0.56, 0.34], "region": "dec"}
  ],
  "edges": [
    {"from": "imgs", "to": "enc_img"},
    {"from": "enc_img", "to": "F"},
    {"from": "F", "to": "mul"},
    {"from": "mul", "to": "Fhat"},
    {"from": "pts", "to": "prior"},
    {"from": "prior", "to": "W"},
    {"from": "W", "to": "mul", "from_side": "top", "to_side": "bottom"},
    {"from": "Fhat", "to": "decoder"},
    {"from": "decoder", "to": "pred"},
    {"from": "W", "to": "Lgeo", "style": "dashed"},
    {"from": "pred", "to": "Lrec", "style": "dashed", "from_side": "bottom", "to_side": "top"}
  ],
  "legend": {
    "columns": 3,
    "line_styles": true
  }
}
